# ===================== CropCare configuration =====================
# Copy this file to  .env  and fill in your values.   cp .env.example .env
# NEVER commit .env to Git (it is already in .gitignore).
# Do NOT put quotes around the values.

# ---- Flask ----
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=false
PORT=8000

# ---- MongoDB Atlas ----
# Atlas dashboard -> Connect -> Drivers -> copy the connection string and replace <password>.
# If your password contains special characters (@ : / ? # % etc.) URL-encode them, e.g. @ -> %40
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name that CropCare will create/use inside your cluster
MONGODB_DB=cropcare

# ---- Weather (OpenWeatherMap) - crop recommendation ----
WEATHER_API_KEY=your_openweathermap_api_key_here

# ---- Groq LLM - crop tips, Hindi translation, market insight, crop planning ----
GROQ_API_KEY=your_groq_api_key_here
# Optional: override models if Groq retires one
# GROQ_TIPS_MODEL=openai/gpt-oss-120b
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ---- Tavily - real-time web search for market price / crop planning ----
TAVILY_API_KEY=your_tavily_api_key_here
